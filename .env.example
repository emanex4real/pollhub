POSTGRES_USER=pollhub
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pollhub
JWT_SECRET=change-me-to-a-long-random-string
# This account becomes the admin when it registers (used in Step 7)
ADMIN_USERNAME=admin
# Used only by the production file (Step 10)
DOCKERHUB_USERNAME=your-dockerhub-username
AWS_REGION=us-east-2

# Password reset emails (leave SMTP_HOST empty to print links in the API logs instead)
APP_URL=http://localhost:8080
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@yourdomain.com
